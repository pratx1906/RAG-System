# ---------------------------------------------------------------
# Constelli RAG — environment variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------

# JWT secret — MUST be 32+ random characters, never share this
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# Only users with this email domain can log in
ALLOWED_DOMAIN=constelli.com

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ollama models (do not change unless you swap models)
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Max file upload size in MB
UPLOAD_MAX_MB=20

# CORS: comma-separated list of allowed frontend origins.
# Set this to your Vercel/Netlify deployment URL(s).
# Example: https://my-app.vercel.app,https://my-app.netlify.app
CORS_ORIGINS=https://your-app.vercel.app

# These are overridden automatically by docker-compose — leave as-is
# OLLAMA_BASE_URL=http://ollama:11434
# CHROMA_PERSIST_DIR=/app/data/chromadb
# UPLOAD_DIR=/app/data/uploads
# DATABASE_URL=sqlite:////app/data/constelli.db
